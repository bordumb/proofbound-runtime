{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofbound.dev/runtime/experiments/performance/native-result-v1.schema.json",
  "title": "Proofbound Runtime native performance result version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "complete",
    "source",
    "benchmark_executable_sha256",
    "toolchain",
    "build_profile",
    "architecture",
    "protocol",
    "host",
    "runtime",
    "workload",
    "measurements"
  ],
  "properties": {
    "schema": { "const": "proofbound-runtime-performance-result/1" },
    "kind": { "const": "native" },
    "complete": { "const": true },
    "source": { "$ref": "#/$defs/source" },
    "benchmark_executable_sha256": { "$ref": "#/$defs/sha256" },
    "toolchain": { "$ref": "#/$defs/toolchain" },
    "build_profile": { "const": "release" },
    "architecture": { "enum": ["x86_64", "aarch64"] },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmup_count", "sample_count"],
      "properties": {
        "warmup_count": { "const": 10 },
        "sample_count": { "const": 100 }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner_image",
        "cpu_model",
        "cpu_count",
        "memory_bytes",
        "kernel_release",
        "cgroup_version",
        "enabled_controllers",
        "maximum_resident_set_bytes"
      ],
      "properties": {
        "runner_image": { "$ref": "#/$defs/nonempty-text" },
        "cpu_model": { "$ref": "#/$defs/nonempty-text" },
        "cpu_count": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "memory_bytes": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "kernel_release": { "$ref": "#/$defs/nonempty-text" },
        "cgroup_version": { "const": 2 },
        "enabled_controllers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": { "const": "pids" },
          "items": { "$ref": "#/$defs/nonempty-text" }
        },
        "maximum_resident_set_bytes": {
          "anyOf": [
            { "$ref": "#/$defs/nanoseconds" },
            { "type": "null" }
          ]
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pbr_sha256", "launcher_sha256", "verifier_sha256"],
      "properties": {
        "pbr_sha256": { "$ref": "#/$defs/sha256" },
        "launcher_sha256": { "$ref": "#/$defs/sha256" },
        "verifier_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "plan_sha256",
        "executable_sha256",
        "expected_output_sha256"
      ],
      "properties": {
        "id": { "const": "hello-static-v1" },
        "plan_sha256": { "$ref": "#/$defs/sha256" },
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "expected_output_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runs", "total", "phases"],
      "properties": {
        "runs": {
          "type": "array",
          "minItems": 100,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/run" }
        },
        "total": { "$ref": "#/$defs/summary" },
        "phases": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/phase" },
            { "properties": { "phase": { "const": "plan-validation-and-normalization-v1" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/phase" },
            { "properties": { "phase": { "const": "host-and-path-preflight-v1" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/phase" },
            { "properties": { "phase": { "const": "executable-closure-inventory-v1" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/phase" },
            { "properties": { "phase": { "const": "cgroup-creation-and-readback-v1" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/phase" },
            { "properties": { "phase": { "const": "launcher-request-and-identity-revalidation-v1" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/phase" },
            { "properties": { "phase": { "const": "stopped-launcher-creation-v1" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/phase" },
            { "properties": { "phase": { "const": "boundary-installation-v1" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/phase" },
            { "properties": { "phase": { "const": "child-execution-v1" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/phase" },
            { "properties": { "phase": { "const": "process-tree-cleanup-v1" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/phase" },
            { "properties": { "phase": { "const": "stream-collection-v1" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/phase" },
            { "properties": { "phase": { "const": "output-inventory-v1" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/phase" },
            { "properties": { "phase": { "const": "receipt-construction-and-publication-v1" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/phase" },
            { "properties": { "phase": { "const": "run-result-projection-v1" } } }
          ]
        }
          ],
          "items": false
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonempty-text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree_state"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree_state": { "const": "clean" }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "target"],
      "properties": {
        "release": { "$ref": "#/$defs/nonempty-text" },
        "target": { "$ref": "#/$defs/nonempty-text" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "total_ns",
        "phase_samples_ns",
        "receipt_sha256",
        "run_result_sha256",
        "output_sha256"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 99 },
        "total_ns": { "$ref": "#/$defs/nanoseconds" },
        "phase_samples_ns": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "items": { "$ref": "#/$defs/nanoseconds" }
        },
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "run_result_sha256": { "$ref": "#/$defs/sha256" },
        "output_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "summary"],
      "properties": {
        "phase": { "type": "string" },
        "summary": { "$ref": "#/$defs/summary" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "samples_ns",
        "count",
        "minimum_ns",
        "median_ns",
        "p95_ns",
        "maximum_ns"
      ],
      "properties": {
        "samples_ns": {
          "type": "array",
          "minItems": 100,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/nanoseconds" }
        },
        "count": { "const": 100 },
        "minimum_ns": { "$ref": "#/$defs/nanoseconds" },
        "median_ns": { "$ref": "#/$defs/nanoseconds" },
        "p95_ns": { "$ref": "#/$defs/nanoseconds" },
        "maximum_ns": { "$ref": "#/$defs/nanoseconds" }
      }
    },
    "nanoseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    }
  }
}

