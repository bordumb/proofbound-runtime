{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofbound.dev/schemas/proofbound-runtime-doctor-explanation-v2.schema.json",
  "title": "Proofbound Runtime doctor explanation version 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capabilities",
    "schema",
    "supported"
  ],
  "properties": {
    "schema": {
      "const": "proofbound-runtime-doctor-explanation/2"
    },
    "supported": {
      "type": "boolean"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "cgroup_v2",
        "kernel_release",
        "landlock",
        "landlock_egress",
        "network_namespace",
        "no_new_privileges",
        "operating_system",
        "seccomp",
        "user_namespace"
      ],
      "properties": {
        "operating_system": {
          "oneOf": [
            {
              "$ref": "#/$defs/unavailable"
            },
            {
              "$ref": "#/$defs/operatingSystem"
            }
          ]
        },
        "architecture": {
          "oneOf": [
            {
              "$ref": "#/$defs/unavailable"
            },
            {
              "$ref": "#/$defs/architecture"
            }
          ]
        },
        "kernel_release": {
          "oneOf": [
            {
              "$ref": "#/$defs/unavailable"
            },
            {
              "$ref": "#/$defs/kernelRelease"
            }
          ]
        },
        "landlock": {
          "oneOf": [
            {
              "$ref": "#/$defs/unavailable"
            },
            {
              "$ref": "#/$defs/landlock"
            }
          ]
        },
        "no_new_privileges": {
          "oneOf": [
            {
              "$ref": "#/$defs/unavailable"
            },
            {
              "$ref": "#/$defs/noNewPrivileges"
            }
          ]
        },
        "seccomp": {
          "oneOf": [
            {
              "$ref": "#/$defs/unavailable"
            },
            {
              "$ref": "#/$defs/seccomp"
            }
          ]
        },
        "cgroup_v2": {
          "oneOf": [
            {
              "$ref": "#/$defs/unavailable"
            },
            {
              "$ref": "#/$defs/cgroupV2"
            }
          ]
        },
        "user_namespace": {
          "oneOf": [
            {
              "$ref": "#/$defs/unavailable"
            },
            {
              "$ref": "#/$defs/userNamespace"
            }
          ]
        },
        "network_namespace": {
          "oneOf": [
            {
              "$ref": "#/$defs/unavailable"
            },
            {
              "$ref": "#/$defs/networkNamespace"
            }
          ]
        },
        "landlock_egress": {
          "oneOf": [
            {
              "$ref": "#/$defs/unavailable"
            },
            {
              "$ref": "#/$defs/landlockEgress"
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "remediation",
        "requirement",
        "status"
      ],
      "properties": {
        "status": {
          "const": "unavailable"
        },
        "code": {
          "enum": [
            "host.landlock.abi-below-egress",
            "host.netns.loopback-failed",
            "host.netns.probe-failed",
            "host.netns.sysctl-disabled",
            "host.userns.apparmor-restricted",
            "host.userns.probe-failed",
            "host.userns.sysctl-disabled",
            "platform.architecture.unsupported",
            "platform.cgroup-v2.controller-missing",
            "platform.cgroup-v2.delegation-unavailable",
            "platform.cgroup-v2.unavailable",
            "platform.kernel-release.unavailable",
            "platform.landlock.abi-unsupported",
            "platform.landlock.unavailable",
            "platform.no-new-privileges.unavailable",
            "platform.os.unsupported",
            "platform.seccomp.action-missing",
            "platform.seccomp.unavailable"
          ]
        },
        "requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "remediation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "operatingSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "status": {
          "const": "available"
        },
        "name": {
          "const": "linux"
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "status": {
          "const": "available"
        },
        "name": {
          "enum": [
            "aarch64",
            "x86_64"
          ]
        }
      }
    },
    "kernelRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "status"
      ],
      "properties": {
        "status": {
          "const": "available"
        },
        "release": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "landlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "abi",
        "status"
      ],
      "properties": {
        "status": {
          "const": "available"
        },
        "abi": {
          "type": "integer",
          "minimum": 3,
          "maximum": 11
        }
      }
    },
    "noNewPrivileges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "status"
      ],
      "properties": {
        "status": {
          "const": "available"
        },
        "enabled": {
          "const": true
        }
      }
    },
    "seccomp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available_actions",
        "status"
      ],
      "properties": {
        "status": {
          "const": "available"
        },
        "available_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "minItems": 3,
          "maxItems": 64,
          "uniqueItems": true
        }
      }
    },
    "cgroupV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controllers",
        "directory",
        "directory_inode",
        "mount_id",
        "status",
        "proxy_sibling_supported"
      ],
      "properties": {
        "status": {
          "const": "available"
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "mount_id": {
          "type": "integer",
          "minimum": 1
        },
        "directory_inode": {
          "type": "integer",
          "minimum": 1
        },
        "controllers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "proxy_sibling_supported": {
          "const": true
        }
      }
    },
    "userNamespace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "identity_maps"
      ],
      "properties": {
        "status": {
          "const": "available"
        },
        "identity_maps": {
          "const": true
        }
      }
    },
    "networkNamespace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "loopback_listener"
      ],
      "properties": {
        "status": {
          "const": "available"
        },
        "loopback_listener": {
          "const": "127.0.0.1:3128"
        }
      }
    },
    "landlockEgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "abi"
      ],
      "properties": {
        "status": {
          "const": "available"
        },
        "abi": {
          "type": "integer",
          "minimum": 9,
          "maximum": 11
        }
      }
    }
  }
}
