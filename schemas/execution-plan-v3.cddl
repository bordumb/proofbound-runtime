; Proofbound Runtime execution plan version 3.
; All maps are closed and use text keys. Map ordering and integer encoding use
; the core deterministic requirements of RFC 8949 section 4.2.1.

execution-plan-v3 = {
  "id": plan-id,
  "schema": "proofbound-runtime-plan/3",
  "limits": resource-limits,
  "command": command,
  "authority": authority
}

command = {
  "arguments": [* argument],
  "executable": path,
  "working_directory": path
}

authority = {
  "read": [* path],
  "write": [path],
  "execute": [1*64 path],
  "network": network-authority-v3,
  "environment": [* environment-name],
  "runtime_read": [* absolute-path]
}

resource-limits = {
  "processes": uint32-nonzero,
  "swap_bytes": swap-byte-limit,
  "stderr_bytes": uint64,
  "stdout_bytes": uint64,
  "memory_bytes": memory-byte-limit,
  "wall_time_ms": uint64-nonzero
}

plan-id = text .size (1..128)
path = text .size (1..18446744073709551615)
absolute-path = text .size (1..18446744073709551615)
argument = text
environment-name = text .size (1..18446744073709551615)
uint32-nonzero = 1..4294967295
uint64 = 0..18446744073709551615
uint64-nonzero = 1..18446744073709551615
memory-byte-limit = 65536..1099511627776
swap-byte-limit = 0..1099511627776

network-authority-v3 = "deny" / authenticated-service-session / declared-egress

authenticated-service-session = {
  "mode": "authenticated-service-session",
  "service": service-identity,
  "resolver": resolution-policy,
  "tls": tls-policy,
  "limits": service-session-limits,
  "connector_executable": absolute-path,
  "connector_runtime_read": [* absolute-path],
  "local_channel": local-channel-policy,
  ? "credential_source": credential-source
}

service-identity = {
  "name": service-name,
  "port": tcp-port
}

resolution-policy = {
  "address": resolver-address,
  "port": tcp-port,
  "configuration": absolute-path,
  "maximum_cname_depth": uint16-nonzero,
  "maximum_answer_count": uint16-nonzero,
  "maximum_response_bytes": uint64-nonzero,
  "resolution_deadline_ms": uint64-nonzero,
  "attempt_deadline_ms": uint64-nonzero,
  "address_order": "ipv4-then-ipv6-lexicographic"
}

resolver-address = {
  "family": "ipv4",
  "bytes": bytes .size 4
} / {
  "family": "ipv6",
  "bytes": bytes .size 16
}

tls-policy = {
  "trust_root_set": absolute-path,
  "minimum_version": "tls-1.2" / "tls-1.3",
  "service_name_verification": "dns-san-exact",
  "revocation": "not-checked-recorded-assumption",
  "session_resumption": "deny",
  "early_data": "deny"
}

service-session-limits = {
  "setup_time_ms": uint64-nonzero,
  "session_time_ms": uint64-nonzero,
  "child_to_service_bytes": uint64-nonzero,
  "service_to_child_bytes": uint64-nonzero,
  "dns_messages": 2..65535,
  "endpoint_attempts": uint16-nonzero,
  "tls_handshake_bytes": uint64-nonzero
}

local-channel-policy = {
  "protocol": "unix-stream-v1",
  "child_descriptor": 3..65535
}

credential-source = {
  "id": credential-source-id,
  "service": service-name,
  "environment": environment-name
}

service-name = text .size (1..253)
credential-source-id = text .size (1..128)
tcp-port = 1..65535
uint16-nonzero = 1..65535

; The declared-egress member is closed and stays unavailable for execution
; until all Specification 0017 admission waves complete.
declared-egress = {
  "mode": "declared-egress",
  "endpoints": [1*256 egress-endpoint],
  "resolver": resolution-policy,
  "limits": egress-limits,
  "proxy_executable": absolute-path,
  "proxy_runtime_read": [* absolute-path],
  "proxy_environment": [1*6 proxy-variable]
}

egress-endpoint = {
  "destination": egress-destination,
  "port": tcp-port,
  "protocol": "tcp",
  "tls_sni": sni-binding
}

egress-destination = {
  "kind": "dns-name",
  "name": egress-name,
  "address_scope": "global" / "global-or-private"
} / {
  "kind": "ipv4",
  "bytes": bytes .size 4
} / {
  "kind": "ipv6",
  "bytes": bytes .size 16
}

sni-binding = "not-inspected" / {
  "mode": "required",
  "name": egress-name
}

egress-limits = {
  "connections": 1..8192,
  "concurrent_connections": 1..512,
  "attempts_per_connection": 1..4,
  "resolutions": 1..1024,
  "dns_messages": 2..8192,
  "client_to_remote_bytes": 1..1099511627776,
  "remote_to_client_bytes": 1..1099511627776,
  "connection_idle_ms": 1..3600000
}

proxy-variable = "HTTPS_PROXY" / "https_proxy"
  / "HTTP_PROXY" / "http_proxy"
  / "ALL_PROXY" / "all_proxy"
egress-name = text .size (1..253)
