{
  "address_classes": "address-class-table-v1",
  "cgroup": {
    "memory.max": "65536",
    "memory.oom.group": 1,
    "memory.swap.max": "0",
    "pids.max": 2,
    "stderr_bytes": "1024",
    "stdout_bytes": "1024",
    "wall_time_ms": 1000
  },
  "child_filter": "hex:1111111111111111111111111111111111111111111111111111111111111111",
  "child_landlock_network": {
    "bind_ports": [],
    "connect_ports": [
      3128
    ],
    "handled": [
      "tcp-bind",
      "tcp-connect"
    ]
  },
  "child_landlock_scope": {
    "abstract_unix_socket": true,
    "signal": true
  },
  "child_network": "egress-namespace-v1",
  "egress": {
    "endpoints": [
      {
        "destination": {
          "address_scope": "global",
          "kind": "dns-name",
          "name": "api.example"
        },
        "port": 443,
        "protocol": "tcp",
        "tls_sni": {
          "mode": "required",
          "name": "api.example"
        }
      }
    ],
    "limits": {
      "attempts_per_connection": 2,
      "client_to_remote_bytes": 100000,
      "concurrent_connections": 2,
      "connection_idle_ms": 1000,
      "connections": 10,
      "dns_messages": 20,
      "remote_to_client_bytes": 100000,
      "resolutions": 10
    },
    "mode": "declared-egress",
    "proxy_environment": [
      "HTTPS_PROXY",
      "https_proxy"
    ],
    "proxy_executable": "/usr/bin/pbr-egress-proxy",
    "proxy_runtime_read": [],
    "resolver": {
      "address": {
        "bytes": "hex:08080808",
        "family": "ipv4"
      },
      "address_order": "ipv4-then-ipv6-lexicographic",
      "attempt_deadline_ms": 10000,
      "configuration": "/etc/resolv.conf",
      "maximum_answer_count": 16,
      "maximum_cname_depth": 4,
      "maximum_response_bytes": "65535",
      "port": 53,
      "resolution_deadline_ms": 60000
    }
  },
  "environment": [],
  "filesystem": [
    {
      "access": "execute",
      "path": "bin/hello",
      "role": "runtime-executable"
    },
    {
      "access": "write",
      "path": "out",
      "role": "output-root"
    }
  ],
  "listener": {
    "address": "hex:7f000001",
    "backlog": 128,
    "port": 3128
  },
  "network": "deny-network-v1",
  "no_new_privileges": true,
  "proxy_filter": "hex:2222222222222222222222222222222222222222222222222222222222222222",
  "proxy_landlock_network": {
    "bind_ports": [],
    "connect_ports": [
      53,
      443
    ],
    "handled": [
      "tcp-bind",
      "tcp-connect"
    ]
  },
  "schema": "proofbound-runtime-linux-policy/3"
}
